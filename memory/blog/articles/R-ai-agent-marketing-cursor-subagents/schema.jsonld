    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/ai-agent-marketing-cursor-subagents/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/ai-agent-marketing-cursor-subagents/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как создать ai агента новичку в Cursor без кода?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сделайте папку .cursor/agents/, два markdown-файла с YAML (research readonly + draft) и правило \"когда кого звать\". Прогоните цикл до файла в marketing-out/. Код руками писать не нужно – агент следует инструкции в файле."
          }
        },
        {
          "@type": "Question",
          "name": "Чем субагент отличается от одного длинного чата?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В длинном чате research и текст смешиваются, контекст плывёт. Субагент получает узкий description и отдельный контекст: сначала brief, потом draft. Используйте субагента, когда нужен повторяемый артефакт, а не бесконечная переписка."
          }
        },
        {
          "@type": "Question",
          "name": "С скольких агентов начинать и почему не с десяти?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Официальный ориентир Cursor – 2–3 focused роли. Десятки размытых субагентов раздувают старт чата: на форуме зафиксировали скачок с ~1,4K до ~11,4K токенов при 60 агентах. Не делайте зоопарк в первую неделю."
          }
        },
        {
          "@type": "Question",
          "name": "Нужны ли Cloud Agents сразу или хватит локальных .cursor/agents/?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На день 1 хватит локальных файлов в проекте. Cloud Agents – когда нужна работа по расписанию или вне ноутбука. Сначала добейтесь одного стабильного цикла research → draft на диске."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Cursor-агенты отличаются от Make AI Agent и n8n?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Make и n8n сильны в линейных сценариях. Cursor-субагенты – в исследовании и черновиках с изоляцией ролей и файлами. Проверьте задачу: \"отправить уведомление\" – Make; \"собрать бриф и пост\" – Cursor-офис."
          }
        },
        {
          "@type": "Question",
          "name": "Куда класть API-ключи, если подключаю MCP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только в env или настройки MCP-сервера, никогда в промпт и не в git. Добавьте в правило проекта запрет на секреты в чате. Розетка инструментов – по гайду MCP; Wordstat и сервисы – на mcp-kv.ru ."
          }
        },
        {
          "@type": "Question",
          "name": "Бесплатные ai агенты – можно ли стартовать без платных подписок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Локальные markdown-субагенты в .cursor/agents/ не требуют \"магазина агентов\": вы пишете роли сами. Лимиты зависят от тарифа Cursor и внешних MCP. Ориентир – два узких файла и один прогон, а не поиск \"бесплатной платформы\" вместо практики."
          }
        }
      ]
    }
  ]
