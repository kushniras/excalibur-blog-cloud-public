    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/avtomatizaciya-marketinga-make-cursor/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/avtomatizaciya-marketinga-make-cursor/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Подойдёт ли автоматизация маркетинга через Make новичку без кода?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Начните с одного сценария из 2–3 модулей, тестового бота и Run once. Код не нужен для уведомления о заявке или строки в таблице."
          }
        },
        {
          "@type": "Question",
          "name": "С чего начать: лиды, контент или отчёты?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "С той рутины, где чаще теряете деньги или время. Чаще первый день – лиды: форма → Telegram. Контент и отчёты – после первого Success."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько сценариев держать активными на бесплатном тарифе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не больше двух active scenarios. На практике в первый вечер держите один. Второй слот оставьте пустым или под тест."
          }
        },
        {
          "@type": "Question",
          "name": "Когда подключать Cursor, а не наращивать Make?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Когда нужен длинный текст, ТЗ или работа с файлами проекта. Для \"пришла заявка – напиши в чат\" хватает Make. Cursor Jr на GitHub – мягкий вход без перегруза."
          }
        },
        {
          "@type": "Question",
          "name": "Нужны ли Cloud Agents в тот же вечер?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Сначала зелёный Run once. Cloud Agents – когда линейной цепочки мало для ветвящихся задач; это следующий шаг, не первый выигрыш."
          }
        },
        {
          "@type": "Question",
          "name": "Как не потерять заявки, если форма уже есть, а бота ещё нет?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Поставьте временный след в Google Sheets или Telegram через HTTP/Telegram-модуль. Потом углубите вход по гайду про бота заявок или webhook – уже с зелёным Run once за плечами."
          }
        }
      ]
    }
  ]
