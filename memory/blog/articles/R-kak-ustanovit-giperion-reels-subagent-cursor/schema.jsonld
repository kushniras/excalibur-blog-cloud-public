    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/kak-ustanovit-giperion-reels-subagent-cursor/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/kak-ustanovit-giperion-reels-subagent-cursor/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какая нейросеть для монтажа рилс подойдёт новичку в Cursor?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Готовый Гиперион (плагин videoshorts), а не сборка Whisper руками. Линейный путь выше рассчитан на человека, который боится сломать IDE, а не на \"сначала изучите всех 23 агентов\"."
          }
        },
        {
          "@type": "Question",
          "name": "Чем ИИ для нарезки рилсов отличается от CapCut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Цепочка сама отбирает смысловые хайлайты и отдаёт пакет клипов. CapCut – ручной таймлайн на каждый ролик. Автоматическая нарезка рилсов здесь про готовый publish-пакет, не про \"по таймеру каждые 30 секунд\"."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли видеокарта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Запасной режим на процессоре есть. GPU ускоряет распознавание речи, но не блокирует установку."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли сразу выкладывать в Instagram или YouTube?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сначала откройте клипы локально. Автопостинг – следующий день, не условие \"установили = уже в ленте\"."
          }
        },
        {
          "@type": "Question",
          "name": "Это генерация ролика с нуля?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Нужен уже снятый длинный файл. Если материала ещё нет – это другая задача, не этот маршрут."
          }
        },
        {
          "@type": "Question",
          "name": "Почему в файлах videoshorts, а на экране \"Гиперион\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Так устроен plugin.json: техническое имя плагина и человеческое название. В папке и командах будет videoshorts, в списке плагинов – Гиперион."
          }
        }
      ]
    }
  ]
