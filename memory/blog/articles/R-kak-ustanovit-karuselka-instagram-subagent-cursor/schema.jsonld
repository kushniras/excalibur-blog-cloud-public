    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/kak-ustanovit-karuselka-instagram-subagent-cursor/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/kak-ustanovit-karuselka-instagram-subagent-cursor/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Подойдёт ли установка маркетологу без кода?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Нужны установка Cursor, копирование папки, Reload и вставка ключа в .env. Код ролей уже в репозитории."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это лучше чата \"сделай карусель\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Чат часто отдаёт девять картинок разного стиля без видео на первом слайде. Каруселька режет один master 3×3 и может дать MP4-хук на слайде 1 – пакет цельный и лежит локально."
          }
        },
        {
          "@type": "Question",
          "name": "Обязателен ли Git, или хватит ZIP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Хватит ZIP с GitHub: распаковали, положили в ~/.cursor/plugins/local, Reload. Git удобнее для обновлений, но для первого пакета слайдов не обязателен."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли сразу публиковать в Instagram?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Критерий прогона – Customize + файлы в carusel-memory/. Публикация – отдельный шаг, когда пакет уже устраивает."
          }
        },
        {
          "@type": "Question",
          "name": "Почему анимируется только первый слайд?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Так устроен пайплайн: хук на входе ленты – короткое видео, остальные кадры статичные PNG. Тянуть motion на все девять в первый прогон не нужно и дольше по стоимости API."
          }
        }
      ]
    }
  ]
