    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/scenarij-reels-nejroset-cursor/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/scenarij-reels-nejroset-cursor/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Подойдёт ли сценарий в Cursor маркетологу без опыта съёмки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. Нужны бриф, таблица и телефон. Не нужен курс драматургии. Если IDE пугает – начните с Cursor Junior ."
          }
        },
        {
          "@type": "Question",
          "name": "Чем раскадровка отличается от монтажа Reels?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Раскадровка – лист до камеры. Монтаж – нарезка уже снятого или long-видео. Для монтажа смотрите соседний гайд и Гиперион; здесь первый результат – файл сценария с таблицей."
          }
        },
        {
          "@type": "Question",
          "name": "Зачем три хука, если сниму один ролик?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Чтобы выбрать сильный вход до съёмки и не гадать после публикации. Meta смотрит окно 0–3 сек – лучше иметь три варианта, чем один слабый."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли получить готовое видео нейросетью без съёмки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Полная автогенерация ещё не заменяет раскадровку и съёмку для большинства ниш. Честный путь: таблица → телефон → при необходимости монтаж."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько секунд брать новичку в первый раз?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Выберите 15 секунд. Структура проще: хук 0–3, ценность, один CTA. На 30 сек вернитесь, когда 15 уже стабильно снимаете."
          }
        },
        {
          "@type": "Question",
          "name": "Где взять шаблон на следующие недели?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "После удачного файла оформите Skill в проекте или повторите промпт вручную. Разбор Skills – в гайде для маркетинга ."
          }
        }
      ]
    }
  ]
