    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/tilda-ai-agent-potoki-nejroset/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/tilda-ai-agent-potoki-nejroset/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Как добавить поток в Тильде новичку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сделайте: Настройки → Подключаемые модули → Потоки → Подключить → создать поток → добавить пост. Проверьте, что раздел Потоки виден в панели."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли Тильда, если уже есть WordPress?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если сайт на Тильде – ведите блог в Потоках, не переносите всё ради API. WP удобнее для write-API; Тильда – для скорости лендинга. Не делайте двойной блог без причины."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Tilda AI Agent отличается от автопостинга в Make?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Agent Feeds заполняет поля Потоков в браузере. Make чаще доставляет пост в соцсети и таблицы. Используйте агент для Тильды, Make – для доставки."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли генерировать обложку вместе со статьёй?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: обложка входит в \"Заполнить всё\" через kie.ai. После генерации проверьте кириллицу и смысл кадра. При слабом результате замените обложку вручную."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько черновиков безопасно в день?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ориентир – 1–3 черновика с вычиткой, не конвейер \"20 в прод\". Избегайте пачки без проверки SEO Title/Description."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если панели агента нет?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверьте: расширение включено, выбран manifest.json, открыт пост Потоков, вкладка обновлена. Уберите конфликтующие расширения на tilda.cc. Иначе – переустановите папку по README GitHub."
          }
        }
      ]
    }
  ]
