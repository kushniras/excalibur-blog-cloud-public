    {
      "@type": "FAQPage",
      "@id": "https://mayai.ru/yandeks-metrika-api-cursor-skill/#faq",
      "isPartOf": {
        "@id": "https://mayai.ru/yandeks-metrika-api-cursor-skill/#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Чем яндекс метрика api отличается от кабинета?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Кабинет – клики руками. API – программный запрос отчётов. Сделайте skill и спросите визиты текстом; кабинет оставьте для сверки цифр."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли OAuth или хватит номера счётчика?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Номера счётчика мало: без OAuth-токена API ответит 401. Проверьте, что токен с metrika:read лежит в env, а counter id – отдельно."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли тот же skill через OpenClaw?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: поставьте пакет с ClawHub (yandex-metrika-assistant) и используйте тот же токен. Сначала живой gateway – см. гайд по установке OpenClaw."
          }
        },
        {
          "@type": "Question",
          "name": "С какого отчёта начать новичку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Список счётчиков → визиты по дням за 7 дней → источники. Избегайте Logs API и целей, пока визиты не совпали с кабинетом."
          }
        },
        {
          "@type": "Question",
          "name": "Как не слить токен в git?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Уберите токен из файлов проекта: только секрет окружения или поле плагина. Не делайте commit с .env и не вставляйте токен в чат."
          }
        },
        {
          "@type": "Question",
          "name": "Зачем вообще logs api яндекс метрики?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для выгрузки сырых хитов в свою систему. Для ежедневного \"откуда трафик\" используйте Reporting API через skill – Logs отложите."
          }
        }
      ]
    }
  ]
